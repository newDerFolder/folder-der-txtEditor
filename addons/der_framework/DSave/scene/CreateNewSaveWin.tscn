[gd_scene format=3 uid="uid://dh2ms07yhawi"]

[sub_resource type="GDScript" id="GDScript_csx2u"]
script/source = "extends Window

func _ready() -> void:
	$VBoxContainer/LineEdit.text=\"Slot\"+str(DSaveManager.list_saves().size())
	refresh()

signal changed()

func refresh():
	$VBoxContainer/Label2.visible=false
	for i in DSaveManager.list_saves():
		print(i)
		if $VBoxContainer/LineEdit.text==i:
			$VBoxContainer/Label2.visible=true
	changed.emit()

func _on_line_edit_text_changed(new_text: String) -> void:
	refresh()



func _on_button_pressed() -> void:
	refresh()


func _on_close_requested() -> void:
	queue_free()
"

[sub_resource type="GDScript" id="GDScript_711c2"]
script/source = "extends Button

func _pressed() -> void:
	DSaveManager.create_resource($\"../LineEdit\".text)
	$\"../..\".refresh()
"

