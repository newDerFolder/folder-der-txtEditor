; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="FolderDerTxtEditor"
run/main_scene="uid://drn64b5pav01m"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="uid://dwq48bi8qdqaf"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

ui_save={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":true,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":83,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[internationalization]

locale/locale_filter_mode=0
locale/country_filter=[]

[physics]

common/physics_ticks_per_second=1
common/max_physics_steps_per_frame=1
2d/physics_engine="Dummy"
3d/physics_engine="Dummy"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
